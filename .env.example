# -----------------------------------------------------------------------------
# TradingView
# -----------------------------------------------------------------------------

# Optional cookie for bypassing captcha/paywalled providers in ideas/news flows.
# 1. Open https://www.tradingview.com/symbols/BTCUSD/ideas/ in a browser.
# 2. Open dev tools, verify captcha if needed, then refresh the page.
# 3. Copy the request cookie and paste it here.
TRADINGVIEW_COOKIE="your_cookie_here"

# Optional JWT token for live streamer tests or websocket flows that need auth.
TRADINGVIEW_JWT_TOKEN=""


# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------

# Main application database.
POSTGRES_DSN="postgresql://postgres:postgres@localhost:5432/tradingview_news"

# Maintenance database used by --init-db before creating the target database.
POSTGRES_MAINTENANCE_DB="postgres"

# Optional override for news source config. If unset, built-in defaults are used
# for USDIDR, USDJPY, and USDKRW.
FOREX_NEWS_SOURCES_JSON='{"USDIDR":{"url":"https://id.tradingview.com/symbols/USDIDR/news/","base_currency":"USD","quote_currency":"IDR","locale":"id","language":"id","exchange":"FX_IDC","enabled":true},"USDJPY":{"url":"https://jp.tradingview.com/symbols/USDJPY/news/","base_currency":"USD","quote_currency":"JPY","locale":"jp","language":"ja","exchange":"FX_IDC","enabled":true},"USDKRW":{"url":"https://kr.tradingview.com/symbols/USDKRW/news/","base_currency":"USD","quote_currency":"KRW","locale":"kr","language":"ko","exchange":"FX_IDC","enabled":true}}'


# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# Required only when using a live OpenAI-compatible LLM provider or live LLM tests.
LLM_API_KEY=""

# Default model used by the LLM gateway.
LLM_DEFAULT_MODEL=""

# OpenAI-compatible chat completions base URL. Defaults to OpenRouter when empty.
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Optional specialized models.
LLM_WRITER_MODEL=""
LLM_REVIEW_MODEL=""
LLM_WRITER_MODEL_JA=""

# Optional transport tuning.
LLM_TIMEOUT_SECONDS="60"
LLM_MAX_RETRIES="0"
LLM_MAX_TOKENS="900"


# -----------------------------------------------------------------------------
# Notion Export
# -----------------------------------------------------------------------------

# Required for real Notion export.
NOTION_API_KEY=""

# Configure one of these as the export parent target.
NOTION_DATA_SOURCE_ID=""
NOTION_DATA_SOURCE_ID_ID=""
NOTION_DATA_SOURCE_ID_JA=""
NOTION_PARENT_PAGE_ID=""
NOTION_VERSION=""

# Optional mode hint. The code defaults to data_source.
NOTION_EXPORT_MODE="data_source"

# Optional transport tuning.
NOTION_TIMEOUT_SECONDS="60"
NOTION_MAX_RETRIES="2"


# -----------------------------------------------------------------------------
# Test switches
# -----------------------------------------------------------------------------

# Enable live network tests.
RUN_LIVE_NETWORK="0"

# Enable live LLM tests.
RUN_LLM_LIVE="0"

# Enable live Notion tests.
RUN_NOTION_LIVE="0"


# -----------------------------------------------------------------------------
# Source Enrichment (Phase 1)
# -----------------------------------------------------------------------------

# Enable Trafilatura-based source enrichment (default off).
ENABLE_SOURCE_ENRICHMENT="0"

# Timeout in seconds for each URL extraction.
SOURCE_ENRICHMENT_TIMEOUT_SECONDS="8"

# Minimum extracted text length to consider a source "good".
MIN_ENRICHED_TEXT_LENGTH="600"

# Minimum number of usable sources to write a deep article.
MIN_USABLE_SOURCE_COUNT="2"

# Enable source quality gate (default off). When enabled, insufficient sources
# will prevent the writer from being called.
ENABLE_SOURCE_QUALITY_GATE="0"


# -----------------------------------------------------------------------------
# Structured Editorial Brief (Phase 2)
# -----------------------------------------------------------------------------

# Enable deterministic EditorialBrief generation before writing (default off).
ENABLE_STRUCTURED_BRIEF="0"

# Fallback content type when no source-quality downgrade is required.
DEFAULT_CONTENT_TYPE="deep_article"


# -----------------------------------------------------------------------------
# AI Reviewer (Phase 3)
# -----------------------------------------------------------------------------

# Enable structured AI review after writer + deterministic validators (default off).
ENABLE_AI_REVIEWER="0"

# Allow AI reviewer to call the configured LLM review_profile (default off).
ENABLE_LLM_AI_REVIEWER="0"

# Minimum score for all AIReview dimensions before a draft can be marked ready.
AI_REVIEW_MIN_READY_SCORE="75"

# Reject instead of needs_edit when financial safety issues are detected.
AI_REVIEW_REJECT_ON_FINANCIAL_SAFETY="1"


# -----------------------------------------------------------------------------
# Article Quality Report (Phase 4)
# -----------------------------------------------------------------------------

# Enable deterministic ArticleQualityReport aggregation (default off).
ENABLE_QUALITY_REPORT="0"

# Promptfoo evals are opt-in and not part of normal pytest.
ENABLE_PROMPTFOO_EVALS="0"


# -----------------------------------------------------------------------------
# Optional Rewrite (post-review interface)
# -----------------------------------------------------------------------------

# Enable rewrite planning after review/quality report. This does not rewrite the
# article body yet; it only emits a structured rewrite_plan for editors.
ENABLE_OPTIONAL_REWRITE="0"


# -----------------------------------------------------------------------------
# Notion Feedback Sync (Phase 5)
# -----------------------------------------------------------------------------

# Enable syncing human review feedback from Notion into local feedback store.
ENABLE_NOTION_FEEDBACK_SYNC="0"


# -----------------------------------------------------------------------------
# Runtime Stores
# -----------------------------------------------------------------------------

CONTENT_JOB_STORE_PATH=.runs/content_jobs.jsonl
OBSERVABILITY_EVENT_STORE_PATH=.runs/events.jsonl
REVIEW_FEEDBACK_STORE_PATH=.runs/review_feedback.jsonl
