# -----------------------------------------------------------------------------
# TradingView
# -----------------------------------------------------------------------------

# Optional cookie for bypassing captcha/paywalled providers in ideas/news flows.
# 1. Open https://www.tradingview.com/symbols/BTCUSD/ideas/ in a browser.
# 2. Open dev tools, verify captcha if needed, then refresh the page.
# 3. Copy the request cookie and paste it here.
TRADINGVIEW_COOKIE="your_cookie_here"

# Optional JWT token for live streamer tests or websocket flows that need auth.
TRADINGVIEW_JWT_TOKEN=""


# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------

# Main application database.
POSTGRES_DSN="postgresql://postgres:postgres@localhost:5432/tradingview_news"

# Maintenance database used by --init-db before creating the target database.
POSTGRES_MAINTENANCE_DB="postgres"

# Optional override for news source config. If unset, built-in defaults are used
# for USDIDR, USDJPY, and USDKRW.
FOREX_NEWS_SOURCES_JSON='{"USDIDR":{"url":"https://id.tradingview.com/symbols/USDIDR/news/","base_currency":"USD","quote_currency":"IDR","locale":"id","language":"id","exchange":"FX_IDC","enabled":true},"USDJPY":{"url":"https://jp.tradingview.com/symbols/USDJPY/news/","base_currency":"USD","quote_currency":"JPY","locale":"jp","language":"ja","exchange":"FX_IDC","enabled":true},"USDKRW":{"url":"https://kr.tradingview.com/symbols/USDKRW/news/","base_currency":"USD","quote_currency":"KRW","locale":"kr","language":"ko","exchange":"FX_IDC","enabled":true}}'


# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# Required only when using a live OpenAI-compatible LLM provider or live LLM tests.
LLM_API_KEY=""

# Default model used by the LLM gateway.
LLM_DEFAULT_MODEL=""

# OpenAI-compatible chat completions base URL. Defaults to OpenRouter when empty.
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Optional specialized models.
LLM_WRITER_MODEL=""
LLM_REVIEW_MODEL=""
LLM_WRITER_MODEL_JA=""

# Optional transport tuning.
LLM_TIMEOUT_SECONDS="60"
LLM_MAX_RETRIES="0"
LLM_MAX_TOKENS="900"


# -----------------------------------------------------------------------------
# Notion Export
# -----------------------------------------------------------------------------

# Required for real Notion export.
NOTION_API_KEY=""

# Configure one of these as the export parent target.
NOTION_DATA_SOURCE_ID=""
NOTION_DATA_SOURCE_ID_ID=""
NOTION_DATA_SOURCE_ID_JA=""
NOTION_PARENT_PAGE_ID=""
NOTION_VERSION=""

# Optional mode hint. The code defaults to data_source.
NOTION_EXPORT_MODE="data_source"

# Optional transport tuning.
NOTION_TIMEOUT_SECONDS="60"
NOTION_MAX_RETRIES="2"


# -----------------------------------------------------------------------------
# Test switches
# -----------------------------------------------------------------------------

# Enable live network tests.
RUN_LIVE_NETWORK="0"

# Enable live LLM tests.
RUN_LLM_LIVE="0"

# Enable live Notion tests.
RUN_NOTION_LIVE="0"


# -----------------------------------------------------------------------------
# Runtime Stores
# -----------------------------------------------------------------------------

CONTENT_JOB_STORE_PATH=.runs/content_jobs.jsonl
OBSERVABILITY_EVENT_STORE_PATH=.runs/events.jsonl
REVIEW_FEEDBACK_STORE_PATH=.runs/review_feedback.jsonl
